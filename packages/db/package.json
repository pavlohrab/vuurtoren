{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./web/worker": "./dist/web/worker.js",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=15000"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
