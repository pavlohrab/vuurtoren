# Vuurtoren server settings: copy to deploy/.env (or paste into Dockge's .env box).

# Sign-in for this server. Make the hash with:
#   docker run --rm -it ghcr.io/pavlohrab/vuurtoren-api:latest hash-password
VUURTOREN_USER=me
VUURTOREN_PASSWORD_HASH=

# The port on this machine; put HTTPS in front of it (a Cloudflare Tunnel, a reverse proxy).
VUURTOREN_PORT=8080

# 1 behind a Cloudflare Tunnel (sign-in limits use the visitor's real address), else 0.
VUURTOREN_TRUST_CF=1
