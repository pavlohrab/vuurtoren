# Vuurtoren web container: the Your devices page, the sync place (/api/sync), the language
# server (/nlp/) and the sign-in gate in front of them.
#
# This is an nginx *template*: the official image's entrypoint copies it to
# /etc/nginx/conf.d/default.conf and substitutes ${VUURTOREN_...} environment variables
# (NGINX_ENVSUBST_FILTER=^VUURTOREN_ in web.Dockerfile; nginx's own lower-case $variables are
# left alone). Variables:
#   VUURTOREN_NLP_AUTH  "on" (default): /nlp/ needs a signed-in browser or a device's sync token,
#                     checked by the api service. "off": /nlp/ is open to anyone who can reach
#                     it. Only for setups WITHOUT the api service on a private network; never
#                     turn it off on a server reachable from the internet.

# Cache policy by path; an empty value adds no header (so API answers keep their own).
map $uri $vuurtoren_cache_control {
    default        "";
    ~^/assets/     "public, max-age=31536000, immutable";
    /index.html    "no-cache";
    /devices.js    "no-cache";
    /devices.css   "no-cache";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    # .wasm must be served as application/wasm for streaming compilation.
    types {
        application/wasm wasm;
    }
    include /etc/nginx/mime.types;

    # ---- Security headers ------------------------------------------------------------------
    # Set here only (no add_header inside locations, which would drop these): the cache policy
    # comes from the map above.
    #  - script-src 'self': no inline or third-party script; 'wasm-unsafe-eval' lets the
    #    browser compile SQLite's WebAssembly (browser storage mode).
    #  - style-src 'unsafe-inline': React style attributes. Styles cannot run code.
    #  - connect-src *: the app talks to addresses the user chooses (AnkiConnect on their own
    #    computer, AI providers, a custom NLP server), so it cannot be a fixed list.
    #  - frame-ancestors 'none' + X-Frame-Options: no framing (clickjacking on sign-in).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src * data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cache-Control $vuurtoren_cache_control;

    # ---- Sign-in gate ----------------------------------------------------------------------
    # nginx asks the api service (GET /api/auth/check: 204 or 401) before proxying /api/ and
    # /nlp/. The browser's cookie and a device's Authorization header pass through unchanged.
    # The api checks again itself, so /api/ stays protected even without this gate.
    location = /_vuurtoren_auth {
        internal;
        resolver 127.0.0.11 valid=10s;
        set $vuurtoren_api http://api:8787;
        proxy_pass $vuurtoren_api/api/auth/check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Original-URI $request_uri;
    }

    # Same check for the NLP service: a signed-in browser, or a device's sync token (a phone or
    # computer that syncs through this server uses its language server too). It can be switched
    # off for api-less setups (see top). Without the api service the check cannot answer, so
    # /nlp/ would fail closed (500). A CORS preflight (no credentials) passes; the language
    # server answers it for the origins in VUURTOREN_CORS_ORIGINS.
    location = /_vuurtoren_auth_nlp {
        internal;
        set $vuurtoren_nlp_auth "${VUURTOREN_NLP_AUTH}";
        if ($vuurtoren_nlp_auth = "off") {
            return 204;
        }
        resolver 127.0.0.11 valid=10s;
        set $vuurtoren_api http://api:8787;
        proxy_pass $vuurtoren_api/api/auth/check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
    }

    # A refused check answers JSON (like the api), which the app turns into its sign-in screen.
    # (No add_header here: it would replace the security headers above for this response.)
    location @vuurtoren_signin_required {
        default_type application/json;
        return 401 '{"ok":false,"error":"Sign-in required."}';
    }

    # ---- NLP service -----------------------------------------------------------------------
    # Same-origin access to the NLP service (avoids CORS and HTTPS mixed content):
    #   fetch("/nlp/analyze/text") -> http://nlp:8000/analyze/text
    # The `set` + variable form makes nginx resolve `nlp` lazily via Docker's DNS, so the web
    # container still starts if the NLP container is not up yet.
    location /nlp/ {
        auth_request /_vuurtoren_auth_nlp;
        error_page 401 = @vuurtoren_signin_required;
        resolver 127.0.0.11 valid=10s;
        set $nlp_upstream http://nlp:8000;
        rewrite ^/nlp/(.*)$ /$1 break;
        proxy_pass $nlp_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The NLP service needs neither the session cookie nor the token.
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 120s;      # OCR of multi-page scans is slow
        client_max_body_size 32m;     # PDF/image uploads (service limit is 30 MB)
    }

    # Course import: a whole scanned book in one upload (service limit 200 MB over all files).
    location /nlp/course/ {
        auth_request /_vuurtoren_auth_nlp;
        error_page 401 = @vuurtoren_signin_required;
        resolver 127.0.0.11 valid=10s;
        set $nlp_upstream http://nlp:8000;
        rewrite ^/nlp/(.*)$ /$1 break;
        proxy_pass $nlp_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 300s;
        client_max_body_size 201m;
        proxy_request_buffering off;
    }

    # ---- API (sign-in, sync) ---------------------------------------------------------------
    # Lazy DNS as above, so the web container starts without the api service; the app then
    # works without sign-in and sync, because /api/health does not answer.
    #
    # Host keeps the port ($http_host) so the api's CSRF check can compare it with Origin.
    # X-Real-IP is the client address the api's rate limit uses (behind Cloudflare it reads
    # CF-Connecting-IP instead when VUURTOREN_TRUST_CF=1).

    # Open: tells the app whether a server is here and whether it needs a sign-in.
    location = /api/health {
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:8787;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Sign-in endpoints: reachable without a session (the api rate-limits and checks them).
    location ^~ /api/auth/ {
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:8787;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    # Sync files (sealed on the devices). No gate: a browser's CORS preflight carries no token,
    # and the api checks every other request itself (a session or a sync token; with sign-in
    # off it answers this site and VUURTOREN_ALLOWED_ORIGINS only).
    location ^~ /api/sync/ {
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:8787;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 64m;     # one sync file
        proxy_request_buffering off;
    }

    location /api/ {
        auth_request /_vuurtoren_auth;
        error_page 401 = @vuurtoren_signin_required;
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:8787;
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }

    # ---- The Your devices page -------------------------------------------------------------
    # Hashed build assets are immutable (Cache-Control from the map above).
    location /assets/ {
        try_files $uri =404;
    }

    # The Your devices page; any other path shows it too.
    location / {
        try_files $uri /index.html;
    }
}
