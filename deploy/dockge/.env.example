# Kenning stack settings (Dockge: paste into the stack's ".env" editor).
# Lines starting with # are comments. Values need no quotes.

# ---- Images ----------------------------------------------------------------------------
# GitHub user or organisation that publishes the images: ghcr.io/<owner>/kenning-web etc.
# REQUIRED. If the packages are private, run `docker login ghcr.io` on the Docker host once
# (a GitHub token with read:packages).
KENNING_IMAGE_OWNER=
# Image tag: "latest", or a release such as 1.4.0 to pin a version.
KENNING_TAG=latest

# ---- Sign-in (required before the app is reachable from the internet) -----------------
# Username for the sign-in screen.
KENNING_USER=
# Password hash, made by:  docker run --rm -it ghcr.io/<owner>/kenning-api:latest hash-password
# (or, in the stack directory: docker compose run --rm -it api hash-password)
# Paste the whole line it prints, e.g. scrypt:65536:8:1:AbC...:XyZ...  (it contains no $).
KENNING_PASSWORD_HASH=
# Alternative to the hash: a plain password (works, but logs a warning). Leave empty.
KENNING_PASSWORD=
# Optional bearer token for scripts and the MCP server (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32. Leave empty if you do not need it.
KENNING_TOKEN=
# With neither KENNING_PASSWORD_HASH/KENNING_PASSWORD nor KENNING_TOKEN, sign-in is OFF:
# anyone who can reach the app has all your data. Only acceptable on localhost.

# ---- Cookies, client IP, origins -----------------------------------------------------------
# Session cookie only over https (1). Set 0 only if you open the app over plain http from
# another device on your LAN (http://localhost works with 1 in Chrome and Firefox).
KENNING_COOKIE_SECURE=1
# 1 behind a Cloudflare Tunnel: the sign-in rate limit uses the visitor's real IP from
# the CF-Connecting-IP header. Keep 0 when the app is not reached through Cloudflare
# (the header could then be forged).
KENNING_TRUST_CF=0
# Extra origins allowed to change data, comma-separated, e.g. https://kenning.example.com.
# Normally empty: the request's own address is always allowed. Needed only if a proxy in
# front rewrites the Host header.
KENNING_ALLOWED_ORIGINS=

# ---- Port ----------------------------------------------------------------------------------
# Where the web container is published on the Docker host. 127.0.0.1 = this machine only
# (the tunnel does not need a published port at all). 0.0.0.0 = the whole LAN, plain http.
KENNING_BIND=127.0.0.1
KENNING_WEB_PORT=8080

# ---- Cloudflare Tunnel (optional; enable the "tunnel" profile) ------------------------------
# Token of a remotely managed tunnel (Zero Trust > Networks > Tunnels > your tunnel >
# Docker install command: the long string after --token). Public hostname service: http://web:80
TUNNEL_TOKEN=
# Pinned cloudflared version (https://hub.docker.com/r/cloudflare/cloudflared/tags).
CLOUDFLARED_TAG=2026.11.0
# Dockge/compose: start the tunnel with the stack by listing its profile here.
# COMPOSE_PROFILES=tunnel
