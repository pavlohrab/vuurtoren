# Paste into the stack's .env in Dockge and fill in.

# Sign-in. Make the hash on the server:
#   sudo docker run --rm -it ghcr.io/pavlohrab/vuurtoren-api:latest hash-password
VUURTOREN_USER=pavlo
VUURTOREN_PASSWORD_HASH=

# The folder with the pack archives (dictionary-nl-…, mt-nl-en-…, sentences-nl-…, audio-nl-….tar.gz).
VUURTOREN_PACKS_FOLDER=/mnt/tank/apps/vuurtoren-data/packs-2026.11.1

# A free port on the server; the tunnel points at http://<server-ip>:<port>.
VUURTOREN_WEB_PORT=18080
