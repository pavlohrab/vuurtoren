<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the sealed sync key never goes into a backup or a device transfer. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="vuurtoren-keys.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="vuurtoren-keys.xml" />
  </device-transfer>
</data-extraction-rules>
