<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: no backups (allowBackup="false" in the manifest). A reinstall starts
     clean; your data comes back through sync or Settings → Data & backup. -->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
