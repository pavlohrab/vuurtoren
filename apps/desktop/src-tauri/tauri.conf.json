{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vuurtoren",
  "mainBinaryName": "vuurtoren",
  "version": "../../../package.json",
  "identifier": "app.vuurtoren.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @app/web dev",
    "beforeBuildCommand": "pnpm -w exec turbo run build --filter=@app/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost vuurtoren-nlp: http://vuurtoren-nlp.localhost https: http: data: blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi", "dmg", "app"],
    "category": "Education",
    "shortDescription": "Read Dutch, learn from what you read",
    "longDescription": "Vuurtoren is an open-source reading app for learning Dutch. Everything runs on this computer: your texts and words in one file under Documents/Vuurtoren, a bundled Dutch language server, and Anki through AnkiConnect without extra setup. It syncs with your other devices through a folder, WebDAV or your own Vuurtoren server.",
    "publisher": "Vuurtoren",
    "copyright": "MIT OR Apache-2.0",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": false,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["gstreamer1.0-plugins-good"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RjQ3QjFEMEQzNjU2ODIKUldTQ1ZqWU5IWHYwNkQzRW9XdVlyS1FQZUZ2TmI0OERQMXdKSDZ0a2Y0cmVFZDBZTkJmY2xneHUK",
      "endpoints": []
    }
  }
}
