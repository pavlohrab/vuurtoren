{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "The bundled page on a computer: the app with its local database, sync, AnkiConnect and the bundled language server.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "allow-desktop-info",
    "allow-links-take",
    "allow-close-now",
    "allow-anki-fetch",
    "allow-sync-pick-folder",
    "allow-sync-dir-list",
    "allow-sync-dir-get",
    "allow-sync-dir-put",
    "allow-sync-dir-remove",
    "allow-sync-fetch",
    "allow-sync-allow-host",
    "allow-sync-key-save",
    "allow-sync-key-load",
    "allow-sync-key-forget",
    "allow-db-open",
    "allow-db-exec",
    "allow-db-close",
    "allow-db-export",
    "allow-db-import",
    "allow-db-reveal",
    "allow-db-move",
    "allow-nlp-status",
    "allow-nlp-restart",
    "allow-nlp-retry-packs",
    "allow-self-test-report",
    "allow-lan-start",
    "allow-lan-code",
    "allow-lan-phones",
    "allow-lan-remove",
    "allow-lan-moved",
    "allow-lan-asking",
    "allow-lan-answer",
    "allow-lan-firewall",
    "allow-lan-firewall-allow"
  ]
}
