{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The bundled home page: the offline app (local database, language server) and the Connect screen.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-desktop-info",
    "allow-check-server",
    "allow-connect",
    "allow-change-server",
    "allow-anki-fetch",
    "allow-use-local",
    "allow-sync-pick-folder",
    "allow-sync-dir-list",
    "allow-sync-dir-get",
    "allow-sync-dir-put",
    "allow-sync-dir-remove",
    "allow-sync-fetch",
    "allow-sync-allow-host",
    "allow-sync-key-save",
    "allow-sync-key-load",
    "allow-sync-key-forget",
    "allow-db-open",
    "allow-db-exec",
    "allow-db-close",
    "allow-db-export",
    "allow-db-import",
    "allow-db-reveal",
    "allow-db-move",
    "allow-nlp-status",
    "allow-nlp-restart",
    "allow-nlp-retry-packs",
    "allow-self-test-report"
  ]
}
